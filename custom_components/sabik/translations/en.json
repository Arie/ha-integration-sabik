  "issues": {
    "migrate_mqtt_bridge": {
      "title": "Migrate from the Sabik MQTT bridge",
      "fix_flow": {
        "step": {
          "init": {
            "title": "Stop the Sabik MQTT bridge",
            "description": "Home Assistant still has the entities of the old Ruby/MQTT bridge. Before migrating, stop the bridge and disable it so it doesn't start again. For example, run `docker compose down` in the bridge folder, or `systemctl --user disable --now sabik-mqtt.service` if it runs as a systemd user service.\n\nThe unit's Modbus serial bus allows only one client: while the bridge runs, it and this integration interfere with each other's requests."
          },
          "confirm": {
            "title": "Migrate the entities",
            "description": "Submitting will:\n\n1. Clear the bridge's MQTT discovery topics, so the old entities don't come back.\n2. Remove the old MQTT entities, including the old Sabik Ventilation climate entity (for example `climate.sabik_ventilation`), and the bridge's MQTT devices.\n3. Rename the new Sabik entities to the old entity IDs, so dashboards, automations and history keep working."
          },
          "done": {
            "title": "Migration finished",
            "description": "Renamed entities: {renamed}\nRemoved old entities: {removed}\nNot renamed, because the old ID is still in use:\n{skipped}\n\nNext steps:\n- Uninstall the old Sabik Card from HACS.\n- Automations that used the old Sabik Ventilation climate entity (for example `climate.sabik_ventilation`) should use `fan.sabik`."
          }
        },
        "error": {
          "bridge_running": "The bridge still looks like it is running: it published its status in the last 30 seconds. Stop it, wait half a minute and try again.",
          "discovery_not_cleared": "MQTT was not loaded, so the old discovery topics were not cleared. If the old Sabik MQTT entities come back, restart Home Assistant and run this repair again."
        },
        "abort": {
          "entry_not_loaded": "The Sabik integration is not loaded. Make sure it connects to the unit, then try again."
        }
      }
    }
  }
}
